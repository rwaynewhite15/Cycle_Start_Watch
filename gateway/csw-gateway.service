# systemd unit: sudo cp csw-gateway.service /etc/systemd/system/ && sudo systemctl enable --now csw-gateway
[Unit]
Description=Cycle Start Watch BLE gateway
After=bluetooth.service time-sync.target
Wants=bluetooth.service

[Service]
User=csw
WorkingDirectory=/opt/csw/gateway
ExecStart=/opt/csw/venv/bin/python /opt/csw/gateway/csw_gateway.py --config /etc/csw/gateway.toml run
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
